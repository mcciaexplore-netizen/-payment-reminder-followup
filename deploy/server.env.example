# Copy to .env.server at the repository root; keep the real file private.
# Use a domain whose DNS points to your server (hostname only, no https://).
APP_DOMAIN=payments.example.com
PUBLIC_WEBHOOK_BASE_URL=https://payments.example.com

# Full authenticated workspace. These are also enforced by compose.yaml.
APP_MODE=local
WORKSPACE_DATABASE_PATH=/app/.data/workspace.sqlite3

# Provider integrations stay in preview until deliberately configured/enabled.
WORKSPACE_LIVE_ENABLED=false
WORKSPACE_DEMO_LOGIN_ENABLED=false
CONNECTOR_ALLOWED_HOSTS=

# Optional: provide a Fernet key through your server's secret manager.
# Otherwise the shared data volume stores the generated connector.key.
WORKSPACE_MASTER_KEY=
