# Set these in the Vercel project's Environment Variables, not in Git.
# Use the SQLite Cloud project hostname and an existing, dedicated database.
# Do not paste the dashboard URL or include ?apikey= in the database URL.
APP_MODE=local
WORKSPACE_DATABASE_URL=sqlitecloud://your-project.sqlite.cloud:8860/payment_reminder
# SQLite Cloud API key; set this separately from the URL.
WORKSPACE_DATABASE_TOKEN=
# Reuse the existing connector.key when migrating data with saved connectors.
WORKSPACE_MASTER_KEY=
# Generate two independent random values of at least 32 characters.
WORKSPACE_SETUP_TOKEN=
CRON_SECRET=
WORKSPACE_SCHEDULER_MODE=cron
WORKSPACE_LIVE_ENABLED=false
WORKSPACE_DEMO_LOGIN_ENABLED=false
PUBLIC_WEBHOOK_BASE_URL=https://your-project.vercel.app
