# Copy to .env for command-line configuration, or use the browser settings form.
BUSINESS_ID=local-business
BUSINESS_NAME=Your Company
GMAIL_USER=
GMAIL_APP_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DRY_RUN=true
DEFAULT_OVERDUE_DAYS=7
REMINDER_COOLDOWN_DAYS=7
BUSINESS_TIMEZONE=Asia/Kolkata
# APP_MODE=demo always forces previews and isolates browser sessions.
APP_MODE=local
# DATABASE_PATH=.data/reminders.sqlite3

# Authenticated workspace (app.py, worker.py and webhooks.py use this database).
# WORKSPACE_DATABASE_PATH=.data/workspace.sqlite3
# Live messaging requires an enabled connector and this explicit server switch.
WORKSPACE_LIVE_ENABLED=false
# Optional one-click access to the demo@example.com account. Leave off for real data.
# Uses normal password authentication; this does not create or reset the account.
WORKSPACE_DEMO_LOGIN_ENABLED=false
WORKSPACE_DEMO_PASSWORD=
# Comma-separated trusted HTTPS gateway hostnames. Empty blocks all gateways.
CONNECTOR_ALLOWED_HOSTS=
# Optional Fernet key supplied by your secret manager. Without it a local
# .data/connector.key is created. Back up this key separately from the database.
WORKSPACE_MASTER_KEY=
# Vercel requires hosted SQLite (libSQL), not a local database file.
# Leave these empty to keep the existing local SQLite database.
WORKSPACE_DATABASE_URL=
WORKSPACE_DATABASE_TOKEN=
# Set a random 32+ character code before first-owner setup on a public host.
WORKSPACE_SETUP_TOKEN=
# Use cron for the authenticated Vercel daily reminder check, service for worker.py.
WORKSPACE_SCHEDULER_MODE=service
CRON_SECRET=
# Used when copying customer links; use your own HTTPS origin for external use.
PUBLIC_WEBHOOK_BASE_URL=http://127.0.0.1:8503
