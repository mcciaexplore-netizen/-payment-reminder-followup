FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 APP_MODE=local
RUN useradd --create-home --uid 1000 appuser
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=appuser:appuser . .
# Docker initializes a fresh named volume with these directory permissions.
RUN mkdir -p /app/.data && chown appuser:appuser /app/.data && chmod 700 /app/.data
USER appuser
EXPOSE 8501
# The public proxy reaches this internal listener through the Docker network.
CMD ["python", "-m", "uvicorn", "asgi_app:app", "--host", "0.0.0.0", "--port", "8501", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
